meta {
  name: 11c - Listar Serviços da OS
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/ordem-servico/{{ordemServicoId}}/servico/listar
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  const servicos = res.getBody();
  if (servicos && servicos.length >= 1) {
    bru.setEnvVar("statusServicoId", servicos[0].id);
  }
}
