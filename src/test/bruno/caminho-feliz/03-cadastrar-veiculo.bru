meta {
  name: 03 - Cadastrar Veiculo
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/veiculo
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "clienteId": "{{clienteId}}",
    "placa": "BRA2E19",
    "marca": "Honda",
    "modelo": "Civic",
    "ano": 2021,
    "cor": "Preto"
  }
}

script:post-response {
  const veiculoId = res.getBody().id;
  bru.setEnvVar("veiculoId", veiculoId);
}
