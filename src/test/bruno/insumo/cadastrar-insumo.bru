meta {
  name: Cadastrar insumo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/insumos
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "nome": "Pastilha de freio Wey",
    "precoUnitario": 89.90,
    "estoqueAtual": 24,
    "estoqueMinimo": 30,
    "unidade": "UN"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const body = res.getBody();
    if (body && body.id) {
      bru.setEnvVar("insumoId", body.id);
    }
  }
}
