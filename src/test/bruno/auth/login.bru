meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@oficina.com",
    "senha": "admin123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

script:post-response {
  const token = res.getBody().token;
  bru.setEnvVar("token", token);
}
