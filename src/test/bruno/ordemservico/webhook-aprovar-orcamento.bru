meta {
  name: Webhook Aprovar Orçamento
  type: http
  seq: 99
}

post {
  url: {{baseUrl}}/ordem-servico/:id/orcamento/webhook/aprovar
  body: json
  auth: none
}

body:json {
  {
    "externalId": "{{webhookExternalId}}",
    "observacoes": "Aprovado via webhook"
  }
}

headers {
  X-Webhook-Token: {{webhookToken}}
  Content-Type: application/json
}

params:path {
  id:
}
