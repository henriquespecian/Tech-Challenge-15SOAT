meta {
  name: Listar Servicos da OS
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/ordem-servico/:id/servico/listar
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

params:path {
  id: {{ordemServicoId}}
}

script:post-response {
  const servicos = res.getBody();
  if (servicos && servicos.length >= 1 && servicos[0].id) {
    bru.setEnvVar("servicoStatusId", servicos[0].id);
  }
}
