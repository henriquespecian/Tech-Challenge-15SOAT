meta {
  name: Gerar Orcamento
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/ordem-servico/:id/orcamento
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

params:path {
  id:
}

body:json {
  {
    "itens": [
      {
        "descricao": "Troca de óleo",
        "quantidade": 1,
        "precoUnitario": 150.00
      }
    ],
    "observacoes": "Serviço padrão"
  }
}
