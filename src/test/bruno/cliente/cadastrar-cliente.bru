meta {
  name: Cadastrar Cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cliente
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "nome": "Maria Oliveira",
