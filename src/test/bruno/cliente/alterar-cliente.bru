meta {
  name: Alterar Cliente
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/cliente/:documento
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

